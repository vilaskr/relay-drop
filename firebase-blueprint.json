{
  "entities": {
    "RelayFile": {
      "title": "Relay File",
      "description": "Metadata for a file being transferred via Relay.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique UUID for the file" },
        "pin": { "type": "string", "description": "6-digit access PIN" },
        "originalName": { "type": "string", "description": "Original file name" },
        "mimeType": { "type": "string", "description": "MIME type of the file" },
        "size": { "type": "number", "description": "File size in bytes" },
        "storagePath": { "type": "string", "description": "Path to the file in Firebase Storage" },
        "expiry": { "type": "number", "description": "Timestamp when the file expires" },
        "status": {
          "type": "string",
          "enum": ["active", "downloaded"],
          "description": "Current status of the file transfer"
        },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the record was created" }
      },
      "required": ["id", "pin", "originalName", "mimeType", "size", "storagePath", "expiry", "status"]
    }
  },
  "firestore": {
    "files": {
      "schema": "RelayFile",
      "description": "Collection of active and recently downloaded file transfers indexed by PIN."
    }
  }
}
